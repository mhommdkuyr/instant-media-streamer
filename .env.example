# Database & Cache
DATABASE_URL=postgresql+asyncpg://streamer:streamer_pass@postgres:5432/streamer_db
REDIS_URL=redis://redis:6379/0

# Metadata APIs
TMDB_API_KEY=your_tmdb_api_key_here

# Telegram Streamer & Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_STREAM_CHANNEL_ID=-1001234567890

# Server Config
BACKEND_PORT=8000
FRONTEND_PORT=3000
SECRET_KEY=change_this_to_a_secure_random_string_in_production
